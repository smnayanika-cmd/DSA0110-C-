#include <iostream>
#include <string>
using namespace std;

class Book {
private:
    string title;
    int copies;
    string author;

public:
    Book() : Book("Unknown", 0, "Unknown") {}

    Book(string t) : Book(t, 1, "Unknown") {}

    Book(string t, int c) : Book(t, c, "Unknown") {}

    Book(string t, int c, string a)
        : title(t), copies(c >= 0 ? c : 0), author(a) {
        if (c < 0)
            cout << "Invalid copies. Set to 0.\n";
    }

    void display() const {
        cout << "Title: " << title << '\n';
        cout << "Copies: " << copies << '\n';
        cout << "Author: " << author << "\n\n";
    }
};

int main() {
    Book b1;
    Book b2("C++ Programming");
    Book b3("Data Structures", 5);
    Book b4("Computer Networks", 3, "James");

    b1.display();
    b2.display();
    b3.display();
    b4.display();

    Book b5("Invalid Book", -5, "Unknown");
    b5.display();

    return 0;
}
